{
  "name": "cuaderno-campo",
  "private": true,
  "version": "1.0.0",
  "description": "PWA de gestión de muestras de campo para supervisor y trabajadores",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c green,cyan \"node --watch server/index.js\" \"vite\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "start": "node server/index.js",
    "preview": "vite preview",
    "db:init": "node server/init-db.js",
    "db:reset": "node server/init-db.js --reset",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.6",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^2.0.0"
  }
}
